[Unit]
Description=Audit MUSE MCP skills without automatic network sync
[Service]
Type=oneshot
User=muse
WorkingDirectory=/opt/muse
ExecStart=/usr/bin/python3 /opt/muse/muse-console.py audit --root /opt/muse/skills --state-dir /var/lib/muse
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/muse
